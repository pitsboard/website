---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import IndicatorLight from '../components/IndicatorLight.astro';

interface Props {
  title?: string;
  description?: string;
  layoutType?: 'lp' | 'blog';
}

const { 
  title = "PitsBoard // Experimental Input Platform", 
  description = "A futuristic human-computer interaction research platform and physical modular hardware controller system.",
  layoutType = 'lp'
} = Astro.props;

// Fetch research logs for dynamic blog side bar & latest log link for 'Notes'
const researchLogs = await getCollection('research');
const sortedLogs = researchLogs.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
const latestLogId = sortedLogs[0]?.id || 'log-01';
const notesLink = `/research/${latestLogId}`;
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Google Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  </head>
  <body class="bg-bg-primary text-text-primary min-h-screen antialiased selection:bg-accent-orange/30 selection:text-white">
    {layoutType === 'lp' ? (
      /* --- Landing Page Layout (Single Screen Scroll-Snap) --- */
      <div class="relative flex flex-col min-h-screen">
        <!-- Stark Linear-style Fixed Header -->
        <header class="fixed top-0 left-0 w-full h-16 bg-bg-primary/80 backdrop-blur-xl border-b border-border-color flex items-center justify-between px-3.5 sm:px-6 lg:px-16 z-50 transition-all">
          <a href="/" class="flex items-center text-white text-base font-bold tracking-tighter select-none uppercase font-header">
            <span class="bg-white text-black px-1.5 py-0.5 rounded-sm mr-1 font-extrabold text-xs">PTB</span>
            <span class="font-light tracking-wide text-xs sm:text-sm text-text-secondary group-hover:text-white transition-colors">PitsBoard</span>
          </a>
          
          <nav class="flex items-center space-x-3.5 sm:space-x-8">
            <a href={notesLink} class="text-[11px] sm:text-xs font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">Notes</a>
            <a href="https://discord.gg/nHmPJMR9u" target="_blank" rel="noopener noreferrer" class="text-[11px] sm:text-xs font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">Discord</a>
            <a href="https://x.com/PitsBoardDev" target="_blank" rel="noopener noreferrer" class="text-[11px] sm:text-xs font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">X</a>
            <a href="mailto:contact@pitsboard.com" class="text-[11px] sm:text-xs font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">Email</a>
          </nav>
        </header>

        <main class="flex-1 pt-16">
          <slot />
        </main>

        <!-- LP Footer -->
        <footer class="py-12 px-6 lg:px-16 border-t border-border-color bg-bg-dark/40">
          <div class="max-w-7xl w-full mx-auto flex flex-col md:flex-row justify-between items-center space-y-6 md:space-y-0">
            <div class="flex flex-col space-y-2 text-center md:text-left select-none">
              <span class="text-[9px] text-text-muted font-mono uppercase">© 2026 PITSBOARD. ALL RIGHTS RESERVED.</span>
            </div>
            
            <nav class="flex items-center space-x-8">
              <a href={notesLink} class="text-[10px] font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">Notes</a>
              <a href="https://discord.gg/nHmPJMR9u" target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">Discord</a>
              <a href="https://x.com/PitsBoardDev" target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">X</a>
              <a href="mailto:contact@pitsboard.com" class="text-[10px] font-mono tracking-wider text-text-secondary hover:text-white transition-colors uppercase">Email</a>
            </nav>
          </div>
        </footer>
      </div>
    ) : (
      /* --- Blog Layout (Two-Column fixed Sidebar Explorer) --- */
      <div class="flex min-h-screen">
        <!-- Desktop Sidebar (Hidden on Mobile) -->
        <aside class="hidden lg:flex w-[280px] bg-bg-sidebar border-r border-border-color p-8 fixed h-screen top-0 left-0 overflow-y-auto flex-col justify-between z-40">
          <div class="space-y-10">
            <a href="/" class="inline-flex items-center space-x-2 text-[10px] font-mono text-text-secondary hover:text-white transition-all border border-border-color px-2.5 py-1.5 rounded-sm bg-bg-dark/30">
              <span>← BACK</span>
            </a>
            
            <div class="border-b border-border-color pb-4 space-y-1">
              <span class="font-mono text-[8px] text-accent-red tracking-widest uppercase block">PITSBOARD-LOG // INDEX</span>
              <h3 class="text-sm font-bold text-white font-header uppercase tracking-tight">DEVELOPMENT NOTES</h3>
            </div>

            <!-- Dynamic Post Navigator (Obsidian Vibe) -->
            <nav class="flex flex-col space-y-1.5">
              {sortedLogs.map(log => (
                <a href={`/research/${log.id}`} class="flex items-center justify-between text-xs text-text-secondary hover:text-white hover:bg-border-color/20 p-2 rounded transition-all">
                  <span class="font-mono text-[9px] text-text-muted">{log.data.publishDate.split('-').slice(1).join('/')}</span>
                  <span class="font-medium text-right truncate max-w-[130px]">{log.data.title}</span>
                </a>
              ))}
            </nav>
          </div>

          <div class="space-y-4 border-t border-border-color pt-6">
            <div class="flex items-center space-x-2">
              <IndicatorLight color="red" label="SYS.ONLINE" pulse={true} />
            </div>
            <span class="font-mono text-[8px] text-text-muted block">v0.9.4 // PROTOTYPE</span>
          </div>
        </aside>

        <!-- Main article container (Responsive Full Width on Mobile) -->
        <main class="flex-1 ml-0 lg:ml-[280px] p-6 sm:p-12 lg:p-24 max-w-4xl min-h-screen flex flex-col justify-between w-full">
          <!-- Mobile Top Navigation Header (Visible only on Mobile) -->
          <div class="block lg:hidden mb-8 pb-6 border-b border-border-color space-y-4">
            <div class="flex items-center justify-between">
              <a href="/" class="inline-flex items-center space-x-2 text-[10px] font-mono text-text-secondary hover:text-white transition-all border border-border-color px-2.5 py-1.5 rounded-sm bg-bg-dark/30">
                <span>← BACK</span>
              </a>
              <span class="font-mono text-[9px] text-accent-red tracking-widest uppercase font-semibold">PITSBOARD-LOG</span>
            </div>

            <!-- Mobile Accordion Index for Articles -->
            <details class="border border-border-color/80 bg-bg-dark/40 rounded p-3 text-xs font-mono group">
              <summary class="flex items-center justify-between cursor-pointer text-text-secondary group-hover:text-white select-none">
                <span class="flex items-center space-x-2">
                  <span class="text-accent-red font-bold">●</span>
                  <span class="font-bold text-white uppercase">NOTES INDEX</span>
                </span>
                <span class="text-[9px] text-text-muted font-mono uppercase tracking-wider">SELECT ARTICLE ▼</span>
              </summary>
              <nav class="flex flex-col space-y-1 pt-3 mt-3 border-t border-border-color/60 max-h-[260px] overflow-y-auto custom-scrollbar">
                {sortedLogs.map(log => (
                  <a href={`/research/${log.id}`} class="flex items-center justify-between p-2 rounded hover:bg-border-color/20 text-text-secondary hover:text-white transition-all">
                    <span class="text-[9px] text-text-muted font-mono">{log.data.publishDate.split('-').slice(1).join('/')}</span>
                    <span class="font-medium text-right truncate max-w-[210px]">{log.data.title}</span>
                  </a>
                ))}
              </nav>
            </details>
          </div>

          <div class="flex-1">
            <slot />

            <!-- Article Bottom Quick Navigation -->
            <div class="mt-16 pt-8 border-t border-border-color space-y-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[9px] text-accent-red tracking-widest uppercase font-semibold">DEVELOPMENT NOTES // ARTICLES</span>
                <a href="/" class="text-[9px] font-mono text-text-muted hover:text-white transition-colors">TOP PAGE →</a>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {sortedLogs.map(log => (
                  <a href={`/research/${log.id}`} class="border border-border-color bg-bg-card/20 p-3.5 rounded hover:border-accent-orange/40 hover:bg-bg-card/40 transition-all flex flex-col justify-between space-y-2 group">
                    <div class="flex items-center justify-between">
                      <span class="font-mono text-[8px] text-text-muted">{log.data.publishDate}</span>
                      <span class="text-xs text-text-muted group-hover:text-accent-orange transition-colors">→</span>
                    </div>
                    <h4 class="text-xs font-semibold text-white group-hover:text-accent-orange transition-colors line-clamp-2">{log.data.title}</h4>
                  </a>
                ))}
              </div>
            </div>
          </div>
          
          <footer class="border-t border-border-color pt-8 mt-16 text-[9px] font-mono text-text-muted uppercase">
            <p>© 2026 PitsBoard. All rights reserved.</p>
          </footer>
        </main>
      </div>
    )}
  </body>
</html>
