---
import ImagePlaceholder from './ImagePlaceholder.astro';
import lpContent from '../../data/lp-content.json';

const {
  tag,
  title,
  subtitle,
  desc1,
  desc2,
  aluminumTitle,
  aluminumDesc,
  brassTitle,
  brassDesc,
  walnutTitle,
  walnutDesc,
  acrylicTitle,
  acrylicDesc
} = lpContent.customPlates;
---

<section id="custom-plates" class="py-24 px-6 lg:px-16 border-b border-border-color bg-bg-dark/10">
  <div class="max-w-7xl w-full mx-auto space-y-16">
    
    <!-- Upper Section: 2-Column Hero Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left Side: Explanation Text -->
      <div class="col-span-1 lg:col-span-5 flex flex-col justify-center space-y-6">
        <div class="space-y-2">
          <span class="font-mono text-[10px] tracking-wider text-accent-red uppercase font-semibold block">
            {tag}
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white uppercase tracking-tight font-header border-none pb-0 mt-0 mb-0">
            {title}
          </h2>
        </div>

        <div class="space-y-4 text-text-secondary font-light leading-relaxed max-w-2xl">
          <p class="m-0 text-[15px]">
            {subtitle}
          </p>
          <p class="m-0 text-[15px]">
            {desc1}
          </p>
          <p class="m-0 text-[15px]">
            {desc2}
          </p>
        </div>
      </div>

      <!-- Right Side: Custom Plates Hero Visual Image (Dynamic Switcher) -->
      <div class="col-span-1 lg:col-span-7 flex justify-center">
        <div class="relative w-full max-w-[650px] aspect-[16/10] border border-border-color bg-bg-card/40 rounded-sm overflow-hidden group hover:border-accent-orange/40 transition-colors">
          <img
            id="custom-plates-hero-img"
            src="/images/placeholders/custom-plates-hero_800x450_16-9.png"
            alt="Custom Plates Visual"
            class="w-full h-full object-cover transition-opacity duration-300 opacity-100"
          />
        </div>
      </div>
    </div>

    <!-- Lower Section: 4 Interactive Plates Grid -->
    <div id="custom-plates-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch pt-4">
      
      <!-- Plate 1: Anodized Aluminum -->
      <div
        class="plate-card border border-border-color bg-bg-card/20 rounded-md p-4 flex flex-col justify-between h-full hover:border-accent-orange/40 transition-all group cursor-pointer"
        data-img-src="/images/placeholders/custom-plates-01_800x450_16-9.png"
        data-label="STANDARD // ALUMINUM PLATE"
      >
        <div class="flex flex-col space-y-4 pointer-events-none">
          <!-- Visual Mockup -->
          <div class="relative aspect-video rounded border border-border-color/60 bg-bg-dark/40 flex items-center justify-center overflow-hidden">
            <ImagePlaceholder aspectRatio="aspect-video" label="ALUMINUM PLATE" desc="Raw silver finish." className="absolute inset-0 border-none bg-transparent" />
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold text-white">{aluminumTitle}</h4>
            <p class="text-xs text-text-secondary font-light leading-relaxed">
              {aluminumDesc}
            </p>
          </div>
        </div>
      </div>

      <!-- Plate 2: Solid Brass -->
      <div
        class="plate-card border border-border-color bg-bg-card/20 rounded-md p-4 flex flex-col justify-between h-full hover:border-accent-orange/40 transition-all group cursor-pointer"
        data-img-src="/images/placeholders/custom-plates-02_800x450_16-9.png"
        data-label="DUAL DIAL // SOLID BRASS PLATE"
      >
        <div class="flex flex-col space-y-4 pointer-events-none">
          <!-- Visual Mockup -->
          <div class="relative aspect-video rounded border border-border-color/60 bg-bg-dark/40 flex items-center justify-center overflow-hidden">
            <ImagePlaceholder aspectRatio="aspect-video" label="BRASS PLATE" desc="Heavy gold patina finish." className="absolute inset-0 border-none bg-transparent" />
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold text-white">{brassTitle}</h4>
            <p class="text-xs text-text-secondary font-light leading-relaxed">
              {brassDesc}
            </p>
          </div>
        </div>
      </div>

      <!-- Plate 3: Walnut Wood -->
      <div
        class="plate-card border border-border-color bg-bg-card/20 rounded-md p-4 flex flex-col justify-between h-full hover:border-accent-orange/40 transition-all group cursor-pointer"
        data-img-src="/images/placeholders/custom-plates-03_800x450_16-9.png"
        data-label="DUAL SLIDER // WALNUT WOOD PLATE"
      >
        <div class="flex flex-col space-y-4 pointer-events-none">
          <!-- Visual Mockup -->
          <div class="relative aspect-video rounded border border-border-color/60 bg-bg-dark/40 flex items-center justify-center overflow-hidden">
            <ImagePlaceholder aspectRatio="aspect-video" label="WALNUT PLATE" desc="Organic oil finish." className="absolute inset-0 border-none bg-transparent" />
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold text-white">{walnutTitle}</h4>
            <p class="text-xs text-text-secondary font-light leading-relaxed">
              {walnutDesc}
            </p>
          </div>
        </div>
      </div>

      <!-- Plate 4: Frosted Glass / Acrylic -->
      <div
        class="plate-card border border-border-color bg-bg-card/20 rounded-md p-4 flex flex-col justify-between h-full hover:border-accent-orange/40 transition-all group cursor-pointer"
        data-img-src="/images/placeholders/custom-plates-04_800x450_16-9.png"
        data-label="TRACK PAD // FROSTED GLASS PLATE"
      >
        <div class="flex flex-col space-y-4 pointer-events-none">
          <!-- Visual Mockup -->
          <div class="relative aspect-video rounded border border-border-color/60 bg-bg-dark/40 flex items-center justify-center overflow-hidden">
            <ImagePlaceholder aspectRatio="aspect-video" label="ACRYLIC PLATE" desc="Diffuses LED illumination." className="absolute inset-0 border-none bg-transparent" />
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold text-white">{acrylicTitle}</h4>
            <p class="text-xs text-text-secondary font-light leading-relaxed">
              {acrylicDesc}
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const heroImg = document.getElementById('custom-plates-hero-img') as HTMLImageElement | null;
  const heroLabel = document.getElementById('custom-plates-hero-label');
  const cards = document.querySelectorAll('.plate-card');

  if (heroImg && cards.length > 0) {
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const imgSrc = card.getAttribute('data-img-src');
        const labelText = card.getAttribute('data-label');

        if (imgSrc) {
          // Highlight active card
          cards.forEach(c => {
            c.classList.remove('border-accent-orange', 'bg-bg-card/50', 'ring-1', 'ring-accent-orange/50');
            c.classList.add('border-border-color', 'bg-bg-card/20');
          });
          card.classList.remove('border-border-color', 'bg-bg-card/20');
          card.classList.add('border-accent-orange', 'bg-bg-card/50', 'ring-1', 'ring-accent-orange/50');

          // Smooth image fade transition
          heroImg.classList.add('opacity-0');

          setTimeout(() => {
            heroImg.src = imgSrc;
            if (heroLabel && labelText) {
              heroLabel.textContent = labelText;
            }
            heroImg.classList.remove('opacity-0');
          }, 150);
        }
      });
    });
  }
</script>
