---
import lpContent from '../../data/lp-content.json';

const { 
  tag, 
  title, 
  subtitle, 
  desc1, 
  desc2, 
  feature1Label, 
  feature1Val, 
  feature2Label, 
  feature2Val, 
  feature3Label, 
  feature3Val 
} = lpContent.whatsPitsboard;
---

<section id="whats-pitsboard" class="py-24 px-6 lg:px-16 border-b border-border-color bg-bg-dark/10">
  <div class="max-w-7xl w-full mx-auto space-y-16">
    
    <!-- 2-Column Core Layout (Left: Text Details, Right: Premium Hardware Image) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- Left Side: Details text (7 cols) -->
      <div class="col-span-1 lg:col-span-7 flex flex-col justify-center space-y-8">
        <div class="space-y-4">
          <span class="font-mono text-[10px] tracking-wider text-accent-red uppercase font-semibold block">
            {tag}
          </span>
          <h2 class="text-4xl sm:text-5xl font-extrabold text-white uppercase tracking-tight font-header border-none pb-0 mt-0 mb-0 leading-tight">
            {title}
          </h2>
        </div>

        <div class="space-y-6 text-text-secondary font-light leading-relaxed max-w-2xl">
          <p class="m-0 text-[16px] text-white font-normal leading-normal">
            {subtitle}
          </p>
          <p class="m-0 text-[14px]">
            {desc1}
          </p>
          <p class="m-0 text-[14px]">
            {desc2}
          </p>
        </div>
      </div>

      <!-- Right Side: Conceptual product image (5 cols) -->
      <div class="col-span-1 lg:col-span-5 flex justify-center">
        <img 
          src="/images/placeholders/about-pitsboard-chassis.png" 
          alt="PitsBoard Premium Hardware Chassis" 
          class="w-full max-w-[420px] h-auto object-contain select-none"
        />
      </div>

    </div>

    <!-- Bottom Features Section (Horizontal 3 Columns) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 pt-2">
      
      <!-- Feature 1: Physical Control -->
      <div class="flex items-center space-x-4">
        <!-- touch_app icon -->
        <span class="material-symbols-outlined text-3xl text-accent-orange flex-shrink-0 select-none">touch_app</span>
        <div>
          <span class="font-mono text-[9px] text-text-muted uppercase block leading-none">{feature1Label}</span>
          <span class="text-sm font-bold text-white mt-1.5 block uppercase tracking-wide leading-none">{feature1Val}</span>
        </div>
      </div>

      <!-- Feature 2: Screen Overlay -->
      <div class="flex items-center space-x-4">
        <!-- layers icon -->
        <span class="material-symbols-outlined text-3xl text-accent-orange flex-shrink-0 select-none">layers</span>
        <div>
          <span class="font-mono text-[9px] text-text-muted uppercase block leading-none">{feature2Label}</span>
          <span class="text-sm font-bold text-white mt-1.5 block uppercase tracking-wide leading-none">{feature2Val}</span>
        </div>
      </div>

      <!-- Feature 3: App Profiles -->
      <div class="flex items-center space-x-4">
        <!-- account_box icon -->
        <span class="material-symbols-outlined text-3xl text-accent-orange flex-shrink-0 select-none">account_box</span>
        <div>
          <span class="font-mono text-[9px] text-text-muted uppercase block leading-none">{feature3Label}</span>
          <span class="text-sm font-bold text-white mt-1.5 block uppercase tracking-wide leading-none">{feature3Val}</span>
        </div>
      </div>

    </div>

  </div>
</section>
