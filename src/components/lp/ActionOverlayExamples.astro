---
import ImagePlaceholder from './ImagePlaceholder.astro';
import lpContent from '../../data/lp-content.json';

const { tag, title, subtitle, profiles } = lpContent.actionOverlayExamples;
---

<section id="action-overlay-examples" class="pb-24 pt-12 px-6 lg:px-16 border-b border-border-color bg-bg-dark/10">
  <div class="max-w-7xl w-full mx-auto space-y-24">
    
    <!-- Part: Action Overlay Examples Grid -->
    <div class="space-y-16">
      <!-- Title Section -->
      <div class="space-y-4 max-w-3xl">
        <span class="font-mono text-[9px] text-accent-orange font-bold uppercase tracking-wider block">
          {tag}
        </span>
        <h4 class="text-xl font-bold text-white uppercase font-header m-0">
          {title}
        </h4>
        <p class="text-sm text-text-secondary leading-relaxed font-light">
          {subtitle}
        </p>
      </div>

      <!-- 4-Grid Action Overlay Examples -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {profiles.map((profile: any) => (
          <div class="border border-border-color bg-bg-card/25 rounded-md p-5 space-y-4 flex flex-col justify-between hover:border-accent-orange/20 transition-all">
            <ImagePlaceholder 
              aspectRatio="aspect-video" 
              label={profile.placeholderLabel} 
              desc={profile.desc} 
              className="w-full border-none bg-bg-dark/50" 
            />
            <div class="space-y-3">
              <span class="font-mono text-xs text-accent-orange font-semibold uppercase block">
                {profile.label}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
