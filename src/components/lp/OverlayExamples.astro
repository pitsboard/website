---
import ImagePlaceholder from './ImagePlaceholder.astro';
import lpContent from '../../data/lp-content.json';

const { tag, title, subtitle, profiles } = lpContent.overlayExamples;
---

<section id="overlay-examples" class="pb-24 pt-12 px-6 lg:px-16 border-b border-border-color bg-bg-dark/10">
  <div class="max-w-7xl w-full mx-auto space-y-24">
    
    <!-- Part 1: HUD Profile Examples -->
    <div class="space-y-16">
      <!-- Title Section -->
      <div class="space-y-4 max-w-3xl">
        <span class="font-mono text-[9px] text-accent-orange font-bold uppercase tracking-wider block">
          {tag.replace(/^\d+\s*\/\/\s*/, '')}
        </span>
        <h4 class="text-xl font-bold text-white uppercase font-header m-0">
          {title}
        </h4>
        <p class="text-sm text-text-secondary leading-relaxed font-light">
          {subtitle}
        </p>
      </div>

      <!-- 4-Grid HUD Examples (PC: Vertical Cards / SP: Horizontal Selectors) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 items-stretch">
        
        <!-- Example 1: Image Editing -->
        <div
          class="overlay-example-card border border-border-color bg-bg-card/25 rounded-md p-4 flex flex-row lg:flex-col items-center lg:items-stretch justify-between lg:justify-start gap-4 hover:border-accent-orange/40 transition-all cursor-pointer group h-full"
          data-img-src="/images/placeholders/overlay-profile-01_800x450_16-9.png"
        >
          <div class="w-36 sm:w-44 lg:w-full aspect-video flex-shrink-0 relative rounded overflow-hidden border border-border-color/60 bg-bg-dark/40 order-2 lg:order-1 pointer-events-none">
            <img src="/images/placeholders/overlay-profile-01_800x450_16-9.png" alt={profiles[0].label} class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 lg:flex-initial min-w-0 space-y-1 order-1 lg:order-2 pointer-events-none">
            <span class="font-mono text-[9px] text-accent-orange font-bold uppercase block">PROFILE 01</span>
            <h4 class="text-sm sm:text-base font-bold text-white group-hover:text-accent-orange transition-colors m-0 truncate">{profiles[0].label}</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-snug m-0 line-clamp-2 lg:line-clamp-none">
              Contextual workspace controls overlay.
            </p>
          </div>
        </div>

        <!-- Example 2: 3D Modeling -->
        <div
          class="overlay-example-card border border-border-color bg-bg-card/25 rounded-md p-4 flex flex-row lg:flex-col items-center lg:items-stretch justify-between lg:justify-start gap-4 hover:border-accent-orange/40 transition-all cursor-pointer group h-full"
          data-img-src="/images/placeholders/overlay-profile-02_800x450_16-9.png"
        >
          <div class="w-36 sm:w-44 lg:w-full aspect-video flex-shrink-0 relative rounded overflow-hidden border border-border-color/60 bg-bg-dark/40 order-2 lg:order-1 pointer-events-none">
            <img src="/images/placeholders/overlay-profile-02_800x450_16-9.png" alt={profiles[1].label} class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 lg:flex-initial min-w-0 space-y-1 order-1 lg:order-2 pointer-events-none">
            <span class="font-mono text-[9px] text-accent-orange font-bold uppercase block">PROFILE 02</span>
            <h4 class="text-sm sm:text-base font-bold text-white group-hover:text-accent-orange transition-colors m-0 truncate">{profiles[1].label}</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-snug m-0 line-clamp-2 lg:line-clamp-none">
              Viewport layout and key shortcuts.
            </p>
          </div>
        </div>

        <!-- Example 3: Music Production -->
        <div
          class="overlay-example-card border border-border-color bg-bg-card/25 rounded-md p-4 flex flex-row lg:flex-col items-center lg:items-stretch justify-between lg:justify-start gap-4 hover:border-accent-orange/40 transition-all cursor-pointer group h-full"
          data-img-src="/images/placeholders/overlay-profile-03_800x450_16-9.png"
        >
          <div class="w-36 sm:w-44 lg:w-full aspect-video flex-shrink-0 relative rounded overflow-hidden border border-border-color/60 bg-bg-dark/40 order-2 lg:order-1 pointer-events-none">
            <img src="/images/placeholders/overlay-profile-03_800x450_16-9.png" alt={profiles[2].label} class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 lg:flex-initial min-w-0 space-y-1 order-1 lg:order-2 pointer-events-none">
            <span class="font-mono text-[9px] text-accent-orange font-bold uppercase block">PROFILE 03</span>
            <h4 class="text-sm sm:text-base font-bold text-white group-hover:text-accent-orange transition-colors m-0 truncate">{profiles[2].label}</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-snug m-0 line-clamp-2 lg:line-clamp-none">
              Editor keymap and command palette.
            </p>
          </div>
        </div>

        <!-- Example 4: Video Editing -->
        <div
          class="overlay-example-card border border-border-color bg-bg-card/25 rounded-md p-4 flex flex-row lg:flex-col items-center lg:items-stretch justify-between lg:justify-start gap-4 hover:border-accent-orange/40 transition-all cursor-pointer group h-full"
          data-img-src="/images/placeholders/overlay-profile-04_800x450_16-9.png"
        >
          <div class="w-36 sm:w-44 lg:w-full aspect-video flex-shrink-0 relative rounded overflow-hidden border border-border-color/60 bg-bg-dark/40 order-2 lg:order-1 pointer-events-none">
            <img src="/images/placeholders/overlay-profile-04_800x450_16-9.png" alt={profiles[3].label} class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 lg:flex-initial min-w-0 space-y-1 order-1 lg:order-2 pointer-events-none">
            <span class="font-mono text-[9px] text-accent-orange font-bold uppercase block">PROFILE 04</span>
            <h4 class="text-sm sm:text-base font-bold text-white group-hover:text-accent-orange transition-colors m-0 truncate">{profiles[3].label}</h4>
            <p class="text-xs sm:text-sm text-text-secondary font-light leading-snug m-0 line-clamp-2 lg:line-clamp-none">
              System media and audio routing.
            </p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const overlayMainImg = document.getElementById('overlay-main-img') as HTMLImageElement | null;
  const exampleCards = document.querySelectorAll('.overlay-example-card');

  if (overlayMainImg && exampleCards.length > 0) {
    exampleCards.forEach(card => {
      card.addEventListener('click', () => {
        const imgSrc = card.getAttribute('data-img-src');

        if (imgSrc) {
          // Highlight active card
          exampleCards.forEach(c => {
            c.classList.remove('border-accent-orange', 'bg-bg-card/50', 'ring-1', 'ring-accent-orange/50');
            c.classList.add('border-border-color', 'bg-bg-card/25');
          });
          card.classList.remove('border-border-color', 'bg-bg-card/25');
          card.classList.add('border-accent-orange', 'bg-bg-card/50', 'ring-1', 'ring-accent-orange/50');

          // Smooth image fade transition on Contextual Overlay main image
          overlayMainImg.classList.add('opacity-0');

          setTimeout(() => {
            overlayMainImg.src = imgSrc;
            overlayMainImg.classList.remove('opacity-0');
          }, 150);
        }
      });
    });
  }
</script>
