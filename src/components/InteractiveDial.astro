---
interface Props {
  label?: string;
  min?: number;
  max?: number;
  value?: number;
  unit?: string;
  id?: string;
  color?: 'orange' | 'yellow' | 'black' | 'red';
}

const {
  label = "DIAL-A",
  min = 0,
  max = 100,
  value = 50,
  unit = "%",
  id = "dial-" + Math.random().toString(36).substr(2, 9),
  color = 'orange'
} = Astro.props;

// Accent color mapping based on Teenage Engineering OP-1 / OP-Z knobs
const colors = {
  orange: '#FF5E00',
  yellow: '#FFD600',
  black: '#111111',
  red: '#FF3B30'
};

const accentColor = colors[color];
---

<div class="dial-container" data-id={id}>
  <div class="dial-meta">
    <span class="dial-label">{label}</span>
    <span class="dial-value" id={`${id}-value`}>{value}{unit}</span>
  </div>
  
  <div class="dial-outer">
    <!-- Fine mechanical ticks around the dial -->
    <div class="dial-ticks">
      {Array.from({ length: 11 }).map((_, i) => {
        const angle = -135 + (i * 27); // 270 degree sweep
        return (
          <div 
            class="dial-tick" 
            style={`transform: rotate(${angle}deg) translate(0, -32px)`}
          />
        );
      })}
    </div>
    
    <!-- The physical knob itself -->
    <div class="knob" id={`${id}-knob`} style={`--accent-color: ${accentColor}`}>
      <!-- Center metal cap -->
      <div class="knob-cap"></div>
      <!-- Colored indicator dot -->
      <div class="knob-dot"></div>
    </div>
  </div>
  
  <span class="dial-info-sub">DRAG OR SCROLL TO TUNE</span>
</div>

<style>
  .dial-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    padding: 1.2rem;
    width: 140px;
    height: 165px;
    user-select: none;
    position: relative;
    border-radius: 2px;
  }

  .dial-meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
    font-family: var(--font-mono);
  }

  .dial-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .dial-value {
    font-size: 0.75rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .dial-outer {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.6rem;
  }

  .dial-ticks {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .dial-tick {
    position: absolute;
    width: 1.5px;
    height: 4px;
    background-color: var(--border-color);
    left: calc(50% - 0.75px);
    top: calc(50% - 2px);
    transform-origin: 50% 50%;
  }

  .knob {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: #202024;
    border: 2px solid #323238;
    box-shadow: 
      inset 0 1px 2px rgba(255,255,255,0.05),
      inset 0 -2px 4px rgba(0,0,0,0.4),
      0 4px 8px rgba(0,0,0,0.5);
    position: relative;
    cursor: grab;
    transform: rotate(0deg);
    transition: transform 0.05s linear;
  }

  .knob:active {
    cursor: grabbing;
  }

  .knob-cap {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #141416;
    border: 1px solid #28282E;
    left: calc(50% - 12px);
    top: calc(50% - 12px);
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.5);
  }

  .knob-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-color);
    top: 6px;
    left: calc(50% - 3px);
    box-shadow: 0 0 2px rgba(0,0,0,0.3);
  }

  .dial-info-sub {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
</style>

<script define:vars={{ id, min, max, value, unit }}>
  // Direct client-side interaction script
  const container = document.querySelector(`[data-id="${id}"]`);
  if (container) {
    const knob = container.querySelector(`#${id}-knob`);
    const valueEl = container.querySelector(`#${id}-value`);
    
    let currentVal = value;
    let isDragging = false;
    let startY = 0;
    let startVal = 0;

    // Convert value to degrees (-135 to +135deg for 270 degree range)
    const valToAngle = (v) => {
      const pct = (v - min) / (max - min);
      return -135 + (pct * 270);
    };

    const updateKnobRotation = (v) => {
      const angle = valToAngle(v);
      knob.style.transform = `rotate(${angle}deg)`;
      valueEl.textContent = `${v}${unit}`;
    };

    // Initialize position
    updateKnobRotation(currentVal);

    // Mouse Drag events
    knob.addEventListener('mousedown', (e) => {
      isDragging = true;
      startY = e.clientY;
      startVal = currentVal;
      document.body.style.cursor = 'grabbing';
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      
      const deltaY = startY - e.clientY; // drag up to increase
      const range = max - min;
      const sensitivity = 0.5; // adjust rotation speed
      let newVal = Math.round(startVal + (deltaY * sensitivity));
      
      // Clamp values
      newVal = Math.max(min, Math.min(max, newVal));
      currentVal = newVal;
      
      updateKnobRotation(currentVal);
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        document.body.style.cursor = 'default';
      }
    });

    // Touch events for mobile
    knob.addEventListener('touchstart', (e) => {
      isDragging = true;
      startY = e.touches[0].clientY;
      startVal = currentVal;
      e.preventDefault();
    });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const deltaY = startY - e.touches[0].clientY;
      const sensitivity = 0.5;
      let newVal = Math.round(startVal + (deltaY * sensitivity));
      newVal = Math.max(min, Math.min(max, newVal));
      currentVal = newVal;
      updateKnobRotation(currentVal);
    });

    window.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Scroll Wheel event
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = -e.deltaY;
      const step = (max - min) / 50; // wheel speed
      let newVal = currentVal + (delta > 0 ? Math.ceil(step) : -Math.ceil(step));
      newVal = Math.max(min, Math.min(max, newVal));
      currentVal = newVal;
      updateKnobRotation(currentVal);
    }, { passive: false });
  }
</script>
