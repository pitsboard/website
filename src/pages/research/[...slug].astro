---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const researchEntries = await getCollection('research');
  return researchEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} // PitsBoard Development Notes`} description={entry.data.summary} layoutType="blog">
  <article class="research-article">
    <div class="article-nav">
      <span class="doc-id">DOC-ID: PITSBOARD-LOG-{entry.id.toUpperCase()}</span>
    </div>

    <header class="article-header">
      <div class="article-meta">
        <span class="meta-item"><strong class="mono">DATE:</strong> {entry.data.publishDate}</span>
        <span class="meta-item"><strong class="mono">AUTHOR:</strong> {entry.data.author}</span>
      </div>
      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-summary">{entry.data.summary}</p>
      
      <div class="article-tags">
        {entry.data.tags.map((tag: string) => (
          <span class="tag-badge">#{tag}</span>
        ))}
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .research-article {
    padding-top: 1rem;
    max-width: 760px;
    margin: 0 auto;
  }

  .article-nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 2rem;
  }

  .doc-id {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .article-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .article-meta {
    display: flex;
    gap: 2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .mono {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .article-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }

  .article-summary {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag-badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-secondary);
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }

  /* MDX Content Styles inside laboratory */
  .article-body {
    line-height: 1.7;
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 300;
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-body :global(h2), .article-body :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .article-body :global(h2) {
    font-size: 1.4rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.4rem;
  }

  .article-body :global(h3) {
    font-size: 1.15rem;
  }

  .article-body :global(ul) {
    list-style-type: square;
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background-color: var(--bg-card);
    color: var(--text-primary);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
    border: 1px solid var(--border-color);
  }

  .article-body :global(pre) {
    background-color: #000000 !important;
    border: 1px solid var(--border-color);
    padding: 1.2rem;
    margin: 1.8rem 0;
    overflow-x: auto;
    border-radius: 4px;
  }

  .article-body :global(pre code) {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 0.75rem;
    color: #EEE;
  }

  /* Laboratory Signature Stamp Block */
  .article-footer {
    margin-top: 5rem;
    border-top: 1px dashed var(--border-color);
    padding-top: 2.5rem;
  }

  .signature-box {
    border: 1px solid var(--border-color);
    background-color: var(--bg-card);
    padding: 1.5rem;
    border-radius: 4px;
    max-width: 420px;
  }

  .sig-title {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .sig-lines {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .sig-line {
    display: flex;
    flex-direction: column;
    border-bottom: 1px dotted var(--border-color);
    padding-bottom: 0.3rem;
  }

  .sig-line .lbl {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--text-muted);
  }

  .sig-line .val {
    font-family: var(--font-header);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.02em;
    margin-top: 0.1rem;
  }
</style>
